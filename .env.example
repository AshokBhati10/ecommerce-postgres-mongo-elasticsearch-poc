# --- PostgreSQL ---
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5432/ecommerce

# --- MongoDB ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB=ecommerce

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
ES_INDEX=orders

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Sync strategy for POST /api/orders: "dual_write", "polling" or "celery" ---
SYNC_STRATEGY=dual_write
POLL_INTERVAL_SECONDS=15

# --- Celery / RabbitMQ (async ES sync; SYNC_STRATEGY=celery) ---
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=rpc://

# --- Frontend ---
VITE_API_URL=http://localhost:8000
